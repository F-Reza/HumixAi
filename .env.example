APP_NAME="HumixAi"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Dhaka
APP_URL=http://localhost:8000

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Google Gemini API Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Real AI detection. Configure server-side; no credentials are accepted from visitors.
GPTZERO_API_KEY=
GPTZERO_BASE_URL=https://api.gptzero.me
GPTZERO_MODEL_VERSION=
GPTZERO_MIN_WORDS=80
GPTZERO_MAX_CHARACTERS=60000
GPTZERO_TIMEOUT=45
GEMINI_TIMEOUT=60
GEMINI_MAX_OUTPUT_TOKENS=8192

# Run: php artisan queue:work database --tries=1 --timeout=300
STUDIO_QUEUE_CONNECTION=database
STUDIO_MAX_CHARACTERS=60000
STUDIO_MAX_FILE_KB=6144
STUDIO_DAILY_WORD_LIMIT=20000
STUDIO_MAX_BATCH_SIZE=10
STUDIO_JOB_RETENTION_HOURS=24
STUDIO_ALLOW_REGISTRATION=true
STUDIO_URL_IMPORT_ENABLED=true
STUDIO_URL_IMPORT_MAX_BYTES=1048576
PDFTOTEXT_PATH=pdftotext

# Optional plagiarism/source matching. Separate from GPTZero authorship detection.
WALTER_API_KEY=
WALTER_BASE_URL=https://developer-portal.walterwrites.ai/api
WALTER_TIMEOUT=60

# Optional Stripe hosted checkout. Use Stripe test mode until your plans/webhooks are verified.
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=
STRIPE_PRO_PRICE_ID=
PRO_DAILY_WORD_LIMIT=100000
